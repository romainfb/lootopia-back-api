<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="2025-04-09-add-etape-utilisateur-validation" author="lootopia">
        <createTable tableName="etape_utilisateur_validation">
            <column name="etape_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="utilisateur_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="etape_utilisateur_validation"
                       columnNames="etape_id, utilisateur_id"
                       constraintName="pk_etape_utilisateur_validation"/>

        <addForeignKeyConstraint
                baseTableName="etape_utilisateur_validation"
                baseColumnNames="etape_id"
                referencedTableName="etape"
                referencedColumnNames="id"
                constraintName="fk_etape_utilisateur_validation_etape"/>

        <addForeignKeyConstraint
                baseTableName="etape_utilisateur_validation"
                baseColumnNames="utilisateur_id"
                referencedTableName="utilisateur"
                referencedColumnNames="id"
                constraintName="fk_etape_utilisateur_validation_utilisateur"/>
    </changeSet>
</databaseChangeLog>
