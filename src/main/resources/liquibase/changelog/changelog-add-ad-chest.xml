<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-last-ad-chest-at" author="Florian Pescot-Jourdan">
        <addColumn tableName="utilisateur">
            <column name="last_ad_chest_at" type="timestamp"/>
        </addColumn>
    </changeSet>

    <changeSet id="drop-not-null-transaction-artefact-id" author="Florian Pescot-Jourdan">
        <dropNotNullConstraint tableName="transaction" columnName="artefact_id" columnDataType="integer"/>
    </changeSet>

</databaseChangeLog>
