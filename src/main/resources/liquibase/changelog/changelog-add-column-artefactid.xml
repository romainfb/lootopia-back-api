<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="14-add-artefact-id-to-treasure" author="florian">
        <addColumn tableName="cache">
            <column name="artefact_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="cache"
                baseColumnNames="artefact_id"
                referencedTableName="artefact"
                referencedColumnNames="id"
                constraintName="fk_cache_artefact"/>
    </changeSet>
</databaseChangeLog>
