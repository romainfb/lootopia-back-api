<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <!-- Table Utilisateur -->
    <changeSet id="1" author="Florian Pescot-Jourdan">
        <createTable tableName="Utilisateur">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="mot_de_passe" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="nom" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type_compte" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_mfa_enabled" type="boolean"/>
            <column name="solde_couronnes" type="decimal"/>
        </createTable>
    </changeSet>

    <!-- Table Partenaire -->
    <changeSet id="2" author="Florian Pescot-Jourdan">
        <createTable tableName="Partenaire">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom_entreprise" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="contact_email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="num_siret" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="organisateur_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Add foreign key for organisateur_id -->
        <addForeignKeyConstraint
                constraintName="fk_partenaire_organisateur"
                baseTableName="Partenaire"
                baseColumnNames="organisateur_id"
                referencedTableName="Utilisateur"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Table Chasse -->
    <changeSet id="3" author="Florian Pescot-Jourdan">
        <createTable tableName="Chasse">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="titre" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="mode" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="difficulte" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="nombre_participants" type="integer"/>
            <column name="frais_participation" type="decimal"/>
            <column name="chat_actif" type="boolean"/>
            <column name="organisateur_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Add foreign key for organisateur_id -->
        <addForeignKeyConstraint
                constraintName="fk_chasse_organisateur"
                baseTableName="Chasse"
                baseColumnNames="organisateur_id"
                referencedTableName="Utilisateur"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Table Participation -->
    <changeSet id="4" author="Florian Pescot-Jourdan">
        <createTable tableName="Participation">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="statut" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="date_inscription" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="organisateur_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="utilisateur_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="chasse_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint
                constraintName="fk_participation_organisateur"
                baseTableName="Participation"
                baseColumnNames="organisateur_id"
                referencedTableName="Utilisateur"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_participation_utilisateur"
                baseTableName="Participation"
                baseColumnNames="utilisateur_id"
                referencedTableName="Utilisateur"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_participation_chasse"
                baseTableName="Participation"
                baseColumnNames="chasse_id"
                referencedTableName="Chasse"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Table Etape -->
    <changeSet id="5" author="Florian Pescot-Jourdan">
        <createTable tableName="Etape">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="chasse_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="est_finale" type="boolean"/>
            <column name="type_clef_validation" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Add foreign key for chasse_id -->
        <addForeignKeyConstraint
                constraintName="fk_etape_chasse"
                baseTableName="Etape"
                baseColumnNames="chasse_id"
                referencedTableName="Chasse"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Table Cache -->
    <changeSet id="6" author="Florian Pescot-Jourdan">
        <createTable tableName="Cache">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="chasse_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="coordonnees_gps" type="point">
                <constraints nullable="false"/>
            </column>
            <column name="dimensions" type="json"/>
        </createTable>
        <!-- Add foreign key for chasse_id -->
        <addForeignKeyConstraint
                constraintName="fk_cache_chasse"
                baseTableName="Cache"
                baseColumnNames="chasse_id"
                referencedTableName="Chasse"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Table Recompense -->
    <changeSet id="7" author="Florian Pescot-Jourdan">
        <createTable tableName="Recompense">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="chasse_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="utilisateur_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="valeur" type="decimal"/>
            <column name="description" type="varchar(255)"/>
        </createTable>
        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint
                constraintName="fk_recompense_chasse"
                baseTableName="Recompense"
                baseColumnNames="chasse_id"
                referencedTableName="Chasse"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_recompense_utilisateur"
                baseTableName="Recompense"
                baseColumnNames="utilisateur_id"
                referencedTableName="Utilisateur"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Table Artefact -->
    <changeSet id="8" author="Florian Pescot-Jourdan">
        <createTable tableName="Artefact">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="rareté" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="image" type="varchar(255)"/>
            <column name="cache_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="utilisateur_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint
                constraintName="fk_artefact_cache"
                baseTableName="Artefact"
                baseColumnNames="cache_id"
                referencedTableName="Cache"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_artefact_utilisateur"
                baseTableName="Artefact"
                baseColumnNames="utilisateur_id"
                referencedTableName="Utilisateur"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Table Repere -->
    <changeSet id="9" author="Florian Pescot-Jourdan">
        <createTable tableName="Repere">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="etape_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="coordonnees_gps" type="point">
                <constraints nullable="false"/>
            </column>
            <column name="nom" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Add foreign key for etape_id -->
        <addForeignKeyConstraint
                constraintName="fk_repere_etape"
                baseTableName="Repere"
                baseColumnNames="etape_id"
                referencedTableName="Etape"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Table Transaction -->
    <changeSet id="10" author="yourname">
        <createTable tableName="Transaction">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="utilisateur_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="montant" type="decimal">
                <constraints nullable="false"/>
            </column>
            <column name="type_transaction" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="artefact_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint
                constraintName="fk_transaction_utilisateur"
                baseTableName="Transaction"
                baseColumnNames="utilisateur_id"
                referencedTableName="Utilisateur"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_transaction_artefact"
                baseTableName="Transaction"
                baseColumnNames="artefact_id"
                referencedTableName="Artefact"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>